{
  "manifest_version": 3,
  "name": "Dark Mode",
  "version": "1.3",
  "description": "LENDARIO",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ativar modo escuro",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["dark.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
