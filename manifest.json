{
  "manifest_version": 3,
  "name": "Dark Mode for Brave",
  "version": "1.3",
  "description": "LENDARIO",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ativar modo escuro",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}
